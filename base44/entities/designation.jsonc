{
  "name": "Designation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "title",
    "code",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}