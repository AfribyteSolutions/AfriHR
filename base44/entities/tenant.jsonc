{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "suspended",
        "archived"
      ],
      "default": "trial"
    },
    "country": {
      "type": "string"
    },
    "default_currency": {
      "type": "string",
      "default": "XAF"
    },
    "default_locale": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "default": "en"
    },
    "timezone": {
      "type": "string",
      "default": "Africa/Douala"
    },
    "branding": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "slug",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}