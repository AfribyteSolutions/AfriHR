{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "suspended",
        "archived"
      ],
      "default": "trial"
    },
    "country": {
      "type": "string"
    },
    "company_email": {
      "type": "string",
      "format": "email"
    },
    "industry": {
      "type": "string"
    },
    "company_size": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "primary_color": {
      "type": "string"
    },
    "default_currency": {
      "type": "string",
      "default": "XAF"
    },
    "default_locale": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "default": "en"
    },
    "timezone": {
      "type": "string",
      "default": "Africa/Douala"
    },
    "branding": {
      "type": "object"
    },
    "jurisdiction_code": {
      "type": "string",
      "description": "Primary regulatory jurisdiction; country packs remain versioned/configurable rather than hardcoded."
    },
    "external_org_key": {
      "type": "string",
      "description": "Optional stable organization key for explicit mapping to other Afribyte products."
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "not_configured",
        "in_review",
        "configured",
        "verified",
        "attention_required"
      ],
      "default": "not_configured"
    }
  },
  "required": [
    "name",
    "slug",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}