{
  "name": "JobOpening",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "contract",
        "internship",
        "temporary"
      ]
    },
    "description": {
      "type": "string",
      "format": "richtext"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "paused",
        "closed",
        "archived"
      ],
      "default": "draft"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "closes_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "title",
    "status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}