{
  "name": "EmployeeLoan",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "loan_type": {
      "type": "string",
      "enum": [
        "salary_advance",
        "personal",
        "emergency",
        "equipment",
        "other"
      ]
    },
    "amount_minor": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "term_months": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "active",
        "repaid",
        "cancelled"
      ],
      "default": "pending"
    },
    "approved_amount_minor": {
      "type": "number"
    },
    "monthly_deduction_minor": {
      "type": "number"
    },
    "outstanding_minor": {
      "type": "number"
    },
    "first_deduction_date": {
      "type": "string",
      "format": "date"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_note": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "employee_id",
    "loan_type",
    "amount_minor",
    "currency",
    "term_months",
    "reason",
    "requested_at",
    "status",
    "idempotency_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}