{
  "name": "EmployeeDocument",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "contract",
        "id",
        "qualification",
        "policy",
        "tax",
        "medical",
        "other"
      ]
    },
    "mime_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "number"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "uploaded_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "employee_id",
    "file_uri",
    "file_name",
    "category",
    "uploaded_by",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}