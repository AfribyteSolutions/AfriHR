{
  "name": "AiUsagePolicy",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "allow_aggregate_workforce_analytics": {
      "type": "boolean",
      "default": true
    },
    "allow_employee_personal_data": {
      "type": "boolean",
      "default": false
    },
    "allow_sensitive_hr_data": {
      "type": "boolean",
      "default": false
    },
    "allow_payroll_line_items": {
      "type": "boolean",
      "default": false
    },
    "allow_candidate_personal_data": {
      "type": "boolean",
      "default": false
    },
    "require_human_review": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "last_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_reviewed_by": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}