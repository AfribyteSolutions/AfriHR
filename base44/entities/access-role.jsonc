{
  "name": "AccessRole",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "base_role": {
      "type": "string",
      "enum": [
        "tenant_admin",
        "hr_manager",
        "recruiter",
        "payroll_manager",
        "finance_manager",
        "manager",
        "employee"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "key",
    "name",
    "base_role",
    "permissions",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}